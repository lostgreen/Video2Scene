# Copy to .env.local on a development machine and adjust the paths.
export SMCB_PYTHON=/path/to/conda/env/bin/python
export SMCB_BLENDER_BIN=/path/to/blender
export PATH=/path/to/conda/env/bin:$PATH

# SceneActBench is an isolated execution/evaluation harness. It may use a different Blender.
export SCENEACT_ROOT=/path/to/Video2Scene/third_party/sceneactbench
export SCENEACT_DATA_ROOT=/path/to/external/data/sceneactbench
export SCENEACT_BLENDER_BIN=/path/to/blender
export DISABLE_TELEMETRY=true

# Keep large, reproducible data outside the code checkout. On KML this project uses:
# export SMCB_PROJECT_DATA_ROOT=/m2v_intern/xuboshen/zgw/Video2Scene
# export SMCB_ASSET_ROOT=/m2v_intern/xuboshen/zgw/Video2Scene/assets
# export SMCB_DATA_DIR=/m2v_intern/xuboshen/zgw/Video2Scene/data
# export SMCB_ARTIFACTS_DIR=/m2v_intern/xuboshen/zgw/Video2Scene/artifacts

# Linux headless hosts may need a user-space GLVND loader and vendor manifest.
# export LD_LIBRARY_PATH=/path/to/conda/env/lib
# export __EGL_VENDOR_LIBRARY_FILENAMES=/path/to/10_nvidia.json
